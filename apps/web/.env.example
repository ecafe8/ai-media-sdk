# ───────────────────────────────────────────────
# AI Media SDK — Web Playground Environment
# ───────────────────────────────────────────────
# Copy this file to .env and fill in server-side
# Provider credentials. The browser never receives
# these values; they are read only by the Next.js
# server route.

# ── Azure OpenAI (optional) ──
# API key sent as Authorization: Bearer
AZURE_OPENAI_API_KEY=
# Resource endpoint, e.g. https://<resource>.cognitiveservices.azure.com
AZURE_OPENAI_ENDPOINT=
# API version, e.g. 2024-02-01
AZURE_OPENAI_API_VERSION=
# Image deployment name, e.g. gpt-image-2
AZURE_OPENAI_DEPLOYMENT=

# ── Alibaba Bailian (optional) ──
# DashScope API key sent as Authorization: Bearer
ALIYUN_BAILIAN_API_KEY=
# Region-scoped base URL, e.g. https://{workspace}.cn-beijing.maas.aliyuncs.com/api/v1
ALIYUN_BAILIAN_BASE_URL=

# ── Volcengine Ark (optional) ──
# Ark API key sent as Authorization: Bearer
ARK_API_KEY=
# Optional regional Ark base URL; defaults to https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=

# ── MiniMax (optional) ──
# MiniMax API key sent as Authorization: Bearer
MINIMAX_API_KEY=
# Optional MiniMax base URL; defaults to https://api.minimax.io
MINIMAX_BASE_URL=

# ── Playground request behavior ──
# Per-attempt Provider timeout for image generation requests (milliseconds).
# Image generation can take longer than the SDK default of 30 seconds.
PLAYGROUND_PROVIDER_TIMEOUT_MS=120000
