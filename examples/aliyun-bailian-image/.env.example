# Required: Alibaba Bailian API key (server-side only)
ALIYUN_BAILIAN_API_KEY=replace-with-your-api-key
# Required: region-scoped base URL, including workspace ID
ALIYUN_BAILIAN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# Optional: image model. Wan models use the async image task path.
ALIYUN_BAILIAN_IMAGE_MODEL=qwen-image-2.0-pro
