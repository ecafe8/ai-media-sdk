# Required: Alibaba Bailian (DashScope) API key (server-side only)
ALIYUN_BAILIAN_API_KEY=replace-with-your-api-key
# Required: region-scoped base URL, including workspace ID
ALIYUN_BAILIAN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# Optional: one or comma-separated HappyHorse video models.
ALIYUN_BAILIAN_VIDEO_MODEL=happyhorse-1.1-t2v
# Example batch:
# ALIYUN_BAILIAN_VIDEO_MODEL=happyhorse-1.1-t2v,happyhorse-1.1-i2v
# r2v: 1-9 comma-separated reference image URLs (prompt uses [Image N] to refer to them)
# ALIYUN_BAILIAN_REFERENCE_IMAGE_URLS=https://x/ref1.png,https://x/ref2.png
# video-edit: public http/https source video URL (not base64 or local file)
# ALIYUN_BAILIAN_INPUT_VIDEO_URL=https://x/source.mp4
