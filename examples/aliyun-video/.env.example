# Required: Alibaba Bailian (DashScope) API key (server-side only)
ALIYUN_BAILIAN_API_KEY=replace-with-your-api-key
# Required: region-scoped base URL, including workspace ID
ALIYUN_BAILIAN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# Optional: HappyHorse video model. happyhorse-1.1-t2v (text-to-video), happyhorse-1.1-i2v (first-frame image-to-video).
ALIYUN_BAILIAN_VIDEO_MODEL=happyhorse-1.1-t2v
