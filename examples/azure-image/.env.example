# Required: Azure OpenAI API key (server-side only)
AZURE_OPENAI_API_KEY=replace-with-your-api-key
# Required: Azure resource endpoint, for example https://resource.openai.azure.com
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# Required: API version supported by your deployment
AZURE_OPENAI_API_VERSION=2024-02-01
# Required: image deployment name
AZURE_OPENAI_DEPLOYMENT=gpt-image-2
