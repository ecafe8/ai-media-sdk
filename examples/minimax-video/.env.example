# Required: MiniMax API key (server-side only)
MINIMAX_API_KEY=replace-with-your-api-key
# Optional: MiniMax API base URL. Defaults to https://api.minimax.io.
MINIMAX_BASE_URL=
# Optional: one or comma-separated MiniMax video models.
MINIMAX_VIDEO_MODEL=MiniMax-H3
# Optional: output resolution (768P or 2K). Defaults to 2K.
MINIMAX_RESOLUTION=2K
# Optional: output duration in seconds (4-15). Defaults to 5.
MINIMAX_DURATION=5
# Optional: aspect ratio. Text-to-video requires a concrete ratio
# (21:9, 16:9, 4:3, 1:1, 3:4, 9:16); defaults to 16:9 for text-to-video and
# adaptive for image/reference-to-video when unset.
MINIMAX_RATIO=
# i2v: single first-frame image URL
# MINIMAX_FIRST_FRAME_URL=https://x/first.png
# i2v first & last frame: single last-frame image URL (requires first frame)
# MINIMAX_LAST_FRAME_URL=https://x/last.png
# r2v: up to 9 comma-separated reference image URLs
# MINIMAX_REFERENCE_IMAGE_URLS=https://x/ref1.png,https://x/ref2.png
# r2v: up to 3 comma-separated reference video URLs
# MINIMAX_REFERENCE_VIDEO_URLS=https://x/ref1.mp4
# r2v: up to 3 comma-separated reference audio URLs
# MINIMAX_REFERENCE_AUDIO_URLS=https://x/ref1.mp3
