# Required: Volcengine Ark API key (server-side only)
ARK_API_KEY=replace-with-your-api-key
# Optional: regional Ark base URL; defaults to https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# Optional: one model or a comma-separated model list. 5.0 pro supports high-precision generation + edit.
SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628
# Example batch:
# SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628,doubao-seedream-5-0-lite-260128,doubao-seedream-4-5-251128,doubao-seedream-4-0-250828
