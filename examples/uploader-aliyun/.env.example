# Required: Alibaba Bailian API key (server-side only)
ALIYUN_BAILIAN_API_KEY=replace-with-your-api-key
# Required: region-scoped base URL, including workspace ID
ALIYUN_BAILIAN_BASE_URL=https://your-workspace.cn-beijing.maas.aliyuncs.com/api/v1
# Optional: model the uploaded file is bound to. MUST match the model used in
# the downstream editImage call (DashScope binds uploaded files to one model).
UPLOADER_ALIYUN_MODEL=qwen-image-2.0-pro
# Required: absolute or relative path to the local image file to upload.
UPLOADER_ALIYUN_IMAGE_PATH=./sample.png
# Optional: edit prompt applied to the uploaded reference image.
UPLOADER_ALIYUN_PROMPT=把这张图片转换为水彩画风格
#
# NOTE: This example is for development and testing only.
# - Temporary URLs expire after 48 hours.
# - The Aliyun upload-policy endpoint is rate-limited to 100 QPS per
#   account+model and cannot be expanded. Do NOT use this in production,
#   high-concurrency, or load-test scenarios. Use durable Aliyun OSS instead.
