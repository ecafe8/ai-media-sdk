# Required: Aliyun Bailian (DashScope) API key for Aliyun uploads.
ALIYUN_BAILIAN_API_KEY=replace-with-your-aliyun-api-key
# Required: Google Gemini API key for Google uploads.
GEMINI_API_KEY=replace-with-your-gemini-api-key
#
# These keys are read server-side by the Vite dev-server middleware and are
# never exposed to the browser bundle.
#
# Reminder: this tool is for development and testing only.
# - Temporary URLs expire after 48 hours.
# - The Aliyun upload-policy endpoint is rate-limited to 100 QPS per
#   account+model and cannot be expanded. Do NOT use in production,
#   high-concurrency, or load-test scenarios. Use durable Aliyun OSS instead.
