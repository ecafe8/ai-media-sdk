{
  "name": "ai-media-sdk",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "release:check": "bun scripts/release-check.ts",
    "release:pack": "bun scripts/release-check.ts --pack",
    "release:version": "bun scripts/release-version.ts",
    "release": "bun scripts/release.ts",
    "docs": "mdts docs"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "mdts": "^0.20.6",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tsup": "^8.5.0",
    "turbo": "^2.9.18",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ]
}
