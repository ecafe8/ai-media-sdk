{
  "name": "@ai-media/sdk",
  "version": "0.1.1",
  "type": "module",
  "description": "Provider-independent AI image and video media SDK",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --clean && tsc -p tsconfig.emit-dts.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:release": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^20",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^7.0.2"
  }
}
