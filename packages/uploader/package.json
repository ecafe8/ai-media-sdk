{
  "name": "@ai-media/uploader",
  "version": "0.1.0",
  "type": "module",
  "description": "Upload helpers for AI media provider inputs",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./aliyun": {
      "types": "./dist/aliyun/index.d.ts",
      "import": "./dist/aliyun/index.js"
    },
    "./google": {
      "types": "./dist/google/index.d.ts",
      "import": "./dist/google/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup src/index.ts src/core/index.ts src/aliyun/index.ts src/google/index.ts --format esm --dts --out-dir dist --clean",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "typecheck:release": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^20",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "^5"
  }
}
